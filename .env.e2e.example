# ── E2E Test Environment ──────────────────────────────
# Copy this file to `.env.e2e` and fill in REAL values before running E2E tests.
#
# ⚠️  SECURITY
# - NEVER commit `.env.e2e` (it is in .gitignore and a CI check enforces it).
# - The values below are PLACEHOLDERS ONLY — they are intentionally obvious
#   so they are unmistakable as fake. Do NOT reuse `password123` or
#   `admin@example.com` in any environment, especially staging/preview.
# - The E2E test user must exist ONLY in a dedicated, isolated test brand.
#   Never give this user access to production data or production brands.
# - Generate the password with at least 24 random chars
#   (e.g. `openssl rand -base64 24`).

# Test user credentials — REPLACE BEFORE USE
E2E_EMAIL=PLACEHOLDER_replace_me@example.test
E2E_PASSWORD=PLACEHOLDER_generate_with_openssl_rand_base64_24
E2E_BRAND_NAME=Demo Brand

# Preview / staging URL (skip local dev server if set)
# PW_BASE_URL=https://your-preview.lovable.app

# Supabase project URL (needed for seeding scripts)
VITE_SUPABASE_URL=https://qmqcjtmcxfqahhubpaea.supabase.co

# Mock webhook receiver (CI only – local tests use httpbin)
# E2E_WEBHOOK_URL=https://127.0.0.1:5055/webhook
# E2E_WEBHOOK_FAIL_URL=https://127.0.0.1:5055/webhook/fail
# MOCK_WEBHOOK_PORT=5055

# Direct DB connection (for seed scripts – CI only)
# DATABASE_URL=postgresql://...
